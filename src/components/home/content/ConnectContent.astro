---
import Button from "../../common/Button.astro";
import { Icon } from "astro-icon/components";

const contactUrl = "/contact";
---

<h2 slot="title" class="about-title scroll-target-title">Keep in touch</h2>

<div class="about-content scroll-target-content">
  <p>
    Please feel free to reach out with any questions, collaborations, or
    opportunities! I am always interested in learning from different
    professionals working in community science, ecology, regional organizing,
    and more.
  </p>
  <p>
    I am also a strong advocate for mentorship and communtiy building in
    scientific spaces. If you are a prospective student or working professional
    looking for mentorship, I encourage you to reach out via the email below.
  </p>

  <div class="connect-icon-links">
    <a
      href="mailto:hayleeoyler@proton.me"
      title="Send me an email"
      aria-label="Email"
    >
      <Icon name="ri:mail-line" size={24} aria-hidden="true" />
    </a>
    <a
      href="https://github.com/haylee360"
      target="_blank"
      rel="noopener noreferrer"
      title="View my GitHub profile"
      aria-label="GitHub"
    >
      <Icon name="ri:github-line" size={22} aria-hidden="true" />
    </a>
    <a
      href="https://www.linkedin.com/in/haylee-oyler/"
      target="_blank"
      rel="noopener noreferrer"
      title="View my LinkedIn profile"
      aria-label="LinkedIn"
    >
      <Icon name="ri:linkedin-box-line" size={22} aria-hidden="true" />
    </a>
  </div>

  <div class="button-group">
    <Button
      class="button"
      href={contactUrl}
      text="See All Contact Info"
      wrapperClass="cta-link"
    />
  </div>
</div>

<style>
  p {
    margin-bottom: 1.5rem;
    line-height: 1.7;
    color: var(--theme-text);
  }

  .connect-icon-links {
    display: flex;
    align-items: center;
    gap: 1.8rem;
    margin-bottom: 2.5rem;
  }

  .connect-icon-links a {
    color: var(--theme-icon-color);
    opacity: 0.8;
    transition:
      opacity 0.2s ease,
      color 0.2s ease;
    display: inline-block;
  }

  .connect-icon-links a:hover,
  .connect-icon-links a:focus {
    opacity: 1;
    outline: none;
  }

  .button-group {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
